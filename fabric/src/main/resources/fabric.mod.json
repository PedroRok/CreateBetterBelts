{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {},
  "license": "${license}",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.pedrorok.createBetterBelt.CreateBetterBelt"
    ],
    "client": [
      "com.pedrorok.createBetterBelt.client.CreateBetterBeltClient"
    ],
    "fabric-datagen": [
      "com.pedrorok.createBetterBelt.data.CreateBetterBeltDatagen"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}",
    "create": ">=6.0.0"
  }
}
